# Configuration of X-Satz.
# Copy this file to .env in the folder you run xsatz from, or set the variables in your shell.
# Variables set in the shell and command line options win over the file.
# .env files are git-ignored and never committed.

# Logo stamped into the title block and the running header of every PDF, PNG or SVG.
XSATZ_LOGO=

# Accent colour of the rules under title block and running header as #RRGGBB.
# Without it the rules take the accent colour of the logo.
XSATZ_COLOR=
