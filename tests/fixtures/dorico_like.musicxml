<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<!DOCTYPE score-partwise PUBLIC "-//Recordare//DTD MusicXML 4.0 Partwise//EN" "http://www.musicxml.org/dtds/partwise.dtd">
<!-- Self-made fixture with invented values, shaped like a Dorico 5 export. -->
<score-partwise version="4.0">
  <work>
    <work-title>Example March</work-title>
  </work>
  <movement-title>Title</movement-title>
  <identification>
    <creator type="composer">adapted by Nobody</creator>
    <rights>© Example Rights</rights>
    <encoding>
      <software>Dorico 5.1.81.2225</software>
      <encoding-date>2026-11-07</encoding-date>
      <supports type="yes" element="print" attribute="new-page" value="yes"/>
    </encoding>
  </identification>
  <defaults>
    <scaling>
      <millimeters>4.33919</millimeters>
      <tenths>40</tenths>
    </scaling>
    <page-layout>
      <page-height>1931.69</page-height>
      <page-width>2734.94</page-width>
    </page-layout>
    <music-font font-family="Bravura" font-size="12.3001"/>
    <word-font font-family="Academico" font-size="6.15004"/>
  </defaults>
  <credit page="1">
    <credit-type>title</credit-type>
    <credit-words default-x="1367" default-y="1800" font-size="20" justify="center">Example March</credit-words>
  </credit>
  <credit page="1">
    <credit-type>part name</credit-type>
    <credit-words default-x="117" default-y="1700" font-size="10">Full Score</credit-words>
  </credit>
  <credit page="1">
    <credit-type>composer</credit-type>
    <credit-words default-x="2617" default-y="1720" font-size="10" justify="right">adapted by Nobody</credit-words>
  </credit>
  <credit page="1">
    <credit-words default-x="2617" default-y="1690" font-size="10" justify="right">for an example band</credit-words>
  </credit>
  <credit page="1">
    <credit-type>arranger</credit-type>
    <credit-words default-x="117" default-y="1650" font-size="5">arr. Somebody</credit-words>
  </credit>
  <credit page="1">
    <credit-type>rights</credit-type>
    <credit-words default-x="1367" default-y="90" font-size="8" justify="center">© Example Rights</credit-words>
  </credit>
  <credit page="2">
