        <unpitched><display-step>G</display-step><display-octave>5</display-octave></unpitched>
        <duration>2</duration>
        <instrument id="P2-X1"/>
        <voice>5</voice>
        <type>half</type>
        <stem>up</stem>
        <notehead>circle-x</notehead>
