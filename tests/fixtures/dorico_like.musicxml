    <credit-words default-x="117" default-y="1850" font-size="10">2</credit-words>
  </credit>
  <part-list>
    <score-part id="P1">
      <part-name>Trombone</part-name>
      <part-abbreviation>Tbn.</part-abbreviation>
    </score-part>
    <score-part id="P2">
      <part-name>Drum Kit</part-name>
      <score-instrument id="P2-X1"><instrument-name>Hi-Hat</instrument-name></score-instrument>
      <score-instrument id="P2-X2"><instrument-name>Snare Drum</instrument-name></score-instrument>
    </score-part>
    <score-part id="P3">
      <part-name>Timpani</part-name>
      <score-instrument id="P3-X1"><instrument-name>Timpani</instrument-name></score-instrument>
    </score-part>
  </part-list>
  <part id="P1">
    <measure number="1">
      <attributes>
        <divisions>1</divisions>
        <key><fifths>-3</fifths></key>
        <time><beats>4</beats><beat-type>4</beat-type></time>
        <clef><sign>G</sign><line>2</line></clef>
      </attributes>
      <direction placement="above" directive="yes" system="only-top">
        <direction-type>
          <words font-family="Academico" font-size="10" justify="center" xml:space="preserve">Intro</words>
        </direction-type>
        <direction-type>
          <rehearsal enclosure="circle">1  </rehearsal>
        </direction-type>
        <direction-type>
          <metronome>
            <beat-unit>quarter</beat-unit>
            <per-minute>100</per-minute>
          </metronome>
        </direction-type>
        <staff>1</staff>
        <sound tempo="100"/>
      </direction>
      <note>
        <pitch><step>E</step><alter>-1</alter><octave>4</octave></pitch>
        <duration>4</duration>
        <type>whole</type>
        <lyric number="1" placement="below">
          <syllabic>single</syllabic>
          <text>1</text>
        </lyric>
      </note>
    </measure>
  </part>
  <part id="P2">
